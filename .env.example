DATABASE_URL=postgres://user:password@localhost:5432/authz_service
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Graph-walk recursion/BFS depth budget — see .claude/commands/build-authz-service.md §6.4.
CHECK_MAX_DEPTH=25
# 0 disables the check-result cache entirely. Write-invalidation is built
# and proven correct (D-135, docs/DECISIONS.md) — safe to set non-zero.
CHECK_CACHE_TTL_MS=0

# Differential-soundness fuzz run (Phase 5) — see
# .claude/commands/build-authz-service.md §6.2 and §9 Phase 5.
SOUNDNESS_FUZZ_QUERIES=5000
# Leave blank for a random seed each run; set to reproduce a specific run
# exactly, e.g. one a CI report linked.
SOUNDNESS_FUZZ_SEED=

# Concurrent check requests during a soundness/report run.
MAX_CONCURRENCY=8
# The `pg` Pool's own `max` option — real Postgres connections this process
# holds open at once. 10 matches `pg`'s own library default exactly, so
# leaving this unset changes nothing. `authz doctor` warns if MAX_CONCURRENCY
# is set >= this value — see docs/DECISIONS.md D-140/D-143.
PG_POOL_MAX=10

# Required for the write routes (POST/DELETE /tuples, POST /schema/publish)
# and, since D-064, the read routes /check, /expand, /list-objects, and
# /list-users too (unauthenticated relationship-graph enumeration was closed
# by gating these the same way) — generate a long random string, never reuse
# across environments.
ADMIN_API_KEY=
# A second, narrower credential tier (see docs/DECISIONS.md D-064's own
# "Revisit if"): holding this key authorizes only the read routes
# (/check, /expand, /list-objects, /list-users), never the write routes.
# Optional — leave blank to keep every read route ADMIN_API_KEY-only, exactly
# as before this variable existed.
READONLY_API_KEY=

# Opt-in horizontal-scaling support: when set, every rate-limit/flood-guard
# budget in src/api/server.ts is backed by this Redis instance instead of
# each process's own in-memory state, so several replicas behind the same
# reverse proxy share one real budget. Leave blank (the default) for a
# single-instance deployment — nothing changes, no Redis client is ever
# constructed. See docs/DECISIONS.md.
REDIS_URL=
