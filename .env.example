DATABASE_URL=postgres://user:password@localhost:5432/authz_service
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Graph-walk recursion/BFS depth budget — see .claude/commands/build-authz-service.md §6.4.
CHECK_MAX_DEPTH=25
# 0 disables the check-result cache entirely. Non-zero only once Phase 4's
# invalidation-on-write story is implemented and tested — see docs/DECISIONS.md.
CHECK_CACHE_TTL_MS=0

# Differential-soundness fuzz run (Phase 5) — see
# .claude/commands/build-authz-service.md §6.2 and §9 Phase 5.
SOUNDNESS_FUZZ_QUERIES=5000
# Leave blank for a random seed each run; set to reproduce a specific run
# exactly, e.g. one a CI report linked.
SOUNDNESS_FUZZ_SEED=

# Concurrent check requests during a soundness/report run.
MAX_CONCURRENCY=8

# Required for the write routes (POST/DELETE /tuples, POST /schema/publish)
# and, since D-064, the read routes /check and /expand too (unauthenticated
# relationship-graph enumeration was closed by gating these the same way) —
# generate a long random string, never reuse across environments.
ADMIN_API_KEY=
