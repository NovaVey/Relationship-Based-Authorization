// SMT-tier self-validation fail-check fixture (docs/DECISIONS.md, the
// entry adding tools/schema-verifier/src/smt/) — this tool's own
// established §8c pathological shape (see `depth-exceeds-limit.authz`,
// D-120), given a second, independent copy here specifically because
// that one is purely monotone (decided by the exact prover before the
// SMT tier is ever reached) and this one needs to be structurally
// non-monotone so `checkAndValidate` actually routes it to the new
// SMT tier. `level0`'s own `gate` relation is a trivial, always-
// satisfiable intersection operand — it exists only to keep `view`
// out of the monotone fragment; the real depth problem is entirely in
// the 30-level `next->view` chain, unchanged from `depth-exceeds-
// limit.authz`'s own design. Generated by a one-off script, not hand-
// typed 30 times, matching that fixture's own precedent.

namespace level0 {
  relation next: level1
  relation gate: user

  permission view = (next->view) & gate
}

namespace level1 {
  relation next: level2

  permission view = next->view
}

namespace level2 {
  relation next: level3

  permission view = next->view
}

namespace level3 {
  relation next: level4

  permission view = next->view
}

namespace level4 {
  relation next: level5

  permission view = next->view
}

namespace level5 {
  relation next: level6

  permission view = next->view
}

