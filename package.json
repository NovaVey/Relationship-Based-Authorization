{
  "name": "relationship-based-authorization",
  "version": "0.1.0",
  "private": true,
  "description": "Fine-grained, relationship-based authorization service in the style of Google Zanzibar — schema DSL, relation tuple store, graph-walking permission checks, and a test suite proving no unauthorized path resolves.",
  "keywords": [
    "authorization",
    "rebac",
    "zanzibar",
    "relationship-based-access-control",
    "permission-checks",
    "typescript",
    "postgres"
  ],
  "homepage": "https://github.com/NovaVey/Relationship-Based-Authorization#readme",
  "bugs": {
    "url": "https://github.com/NovaVey/Relationship-Based-Authorization/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NovaVey/Relationship-Based-Authorization.git"
  },
  "license": "MIT",
  "author": "Tyler Pepitone / Nova Vey Engineering",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "authz": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "start": "node dist/cli/index.js doctor && node dist/cli/index.js serve",
    "cli": "tsx src/cli/index.ts",
    "seed:example": "tsx scripts/seed-example.ts",
    "benchmark": "tsx scripts/benchmark-check-depth.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "pg": "^8.23.0",
    "toad-cache": "^3.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
